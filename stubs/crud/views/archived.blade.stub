                    </thead>
                    <tbody>
                        @foreach ($rows as $%%modelVariable%%)
                            <tr>
%%indexCells%%
                                <td class="text-nowrap">
                                    @php
                                        $when = $state === 'deleted' ? $%%modelVariable%%->deleted_at : $%%modelVariable%%->archived_at;
                                    @endphp
                                    <div>{{ $when?->format('d M Y, H:i') }}</div>
                                    <div class="small text-body-secondary">{{ $when?->diffForHumans() }}</div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <form method="POST" action="{{ route('%%routeName%%.restore', $%%modelVariable%%->getKey()) }}">
                                            @csrf
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Restore</button>
                                        </form>

                                        @if ($state === 'deleted' && Route::has('%%routeName%%.purge'))
                                            <form method="POST"
                                                  action="{{ route('%%routeName%%.purge', $%%modelVariable%%->getKey()) }}"
                                                  onsubmit="return confirm('Delete this %%titleSingular%% permanently? This cannot be undone.')">
                                                @csrf
                                                @method('DELETE')
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete for good</button>
