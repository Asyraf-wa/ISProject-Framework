    <style>
        /* Strip the app shell so the report prints as a plain document. */
        @media print {
            .is-sidebar,
            .is-backdrop,
            .is-topbar { display: none !important; }
            .is-main { margin-inline-start: 0 !important; }
            .is-content { padding: 0 !important; }
            .card { border: 0 !important; box-shadow: none !important; }
            .is-print-header { margin-bottom: 1rem; }
            .is-print-header h2 { font-size: 1.1rem; margin: 0; }
            .is-print-header p { font-size: .8rem; color: #555; margin: 0; }
            table { font-size: .75rem; }
            thead { display: table-header-group; }  /* repeat headers on every page */
            tr { break-inside: avoid; }
        }
