# Copy to .env before running docker compose. These values configure the
# containers only — the sandbox application keeps its own sandbox/.env.

# Match your host user so files written in the container stay editable.
# On WSL/Linux: run `id -u` and `id -g`.
UID=1000
GID=1000

APP_PORT=8080
PHPMYADMIN_PORT=8081
DB_PORT=3307
REDIS_PORT=6380
MAILPIT_PORT=8025
VITE_PORT=5173

DB_DATABASE=isproject
DB_USERNAME=isproject
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
